<Window x:Class="IndexExplorer.Views.KindEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="파일 종류" Icon="/Assets/app.ico" Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource AppFont}" FontSize="13"
        Foreground="{StaticResource InkBrush}" Background="{StaticResource CanvasBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- 설정 창과 같은 모양: 흰 바탕, 쪽 제목, 구역 제목 + 회색 설명, 낮은 입력칸, 아래에 가는 선과 버튼 -->
    <Window.Resources>
        <Style x:Key="FieldTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="LowBox" TargetType="TextBox" BasedOn="{StaticResource FormBox}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="24,12,24,14">
            <DockPanel LastChildFill="False">
                <Button x:Name="DeleteBtn" DockPanel.Dock="Left" Style="{StaticResource ToolButtonB}" Height="30" Padding="10,0" Click="Delete_Click">
                    <TextBlock Text="종류 삭제" Foreground="{StaticResource DestructiveBrush}" />
                </Button>
                <Button x:Name="ResetBtn" DockPanel.Dock="Left" Style="{StaticResource ToolButtonB}" Height="30" Padding="10,0" Content="기본값으로" Click="Reset_Click" />
                <Button x:Name="OkBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="확인" Padding="20,7" IsDefault="True" Click="Ok_Click" />
                <Button DockPanel.Dock="Right" Style="{StaticResource PearlButton}" Content="취소" Padding="18,7" Margin="0,0,8,0" IsCancel="True" />
            </DockPanel>
        </Border>

        <StackPanel Margin="24,18,24,20">
            <DockPanel Margin="0,0,0,16">
                <Image x:Name="KindIcon" DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="Heading" Text="새 종류" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="이름" Style="{StaticResource FieldTitle}" />
            <TextBox x:Name="NameBox" Style="{StaticResource LowBox}" MaxLength="20" />

            <TextBlock Text="확장자" Style="{StaticResource FieldTitle}" Margin="0,16,0,2" />
            <TextBlock x:Name="ExtHint" Margin="0,0,0,6" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" LineHeight="18"
                       Text="쉼표나 띄어쓰기로 나눕니다. 예: py, ipynb" />
            <TextBox x:Name="ExtBox" Style="{StaticResource LowBox}" TextChanged="ExtBox_TextChanged" />
        </StackPanel>
    </DockPanel>
</Window>
