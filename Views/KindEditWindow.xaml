<Window x:Class="IndexExplorer.Views.KindEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="파일 종류" Icon="/Assets/app.ico" Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource AppFont}" FontSize="13"
        Foreground="{StaticResource InkBrush}" Background="{StaticResource SidebarBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="24,20,24,20">
        <StackPanel Orientation="Horizontal">
            <Image x:Name="KindIcon" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock x:Name="Heading" Text="새 종류" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="이름" Margin="0,18,0,6" FontSize="12.5" Foreground="{StaticResource SecondaryBrush}" />
        <TextBox x:Name="NameBox" Style="{StaticResource FormBox}" MaxLength="20" />

        <TextBlock Text="확장자" Margin="0,14,0,6" FontSize="12.5" Foreground="{StaticResource SecondaryBrush}" />
        <TextBox x:Name="ExtBox" Style="{StaticResource FormBox}" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="60" TextChanged="ExtBox_TextChanged" />
        <TextBlock x:Name="ExtHint" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" LineHeight="18"
                   Text="쉼표나 띄어쓰기로 나눕니다. 예: py, ipynb" />

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button x:Name="DeleteBtn" DockPanel.Dock="Left" Style="{StaticResource PearlButton}" Content="종류 삭제" Click="Delete_Click" />
            <Button x:Name="ResetBtn" DockPanel.Dock="Left" Style="{StaticResource PearlButton}" Content="기본값으로" Click="Reset_Click" />
            <Button x:Name="OkBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="확인" Padding="20,8" IsDefault="True" Click="Ok_Click" />
            <Button DockPanel.Dock="Right" Style="{StaticResource PearlButton}" Content="취소" Padding="18,8" Margin="0,0,10,0" IsCancel="True" />
        </DockPanel>
    </StackPanel>
</Window>
