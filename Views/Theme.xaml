<!--
    Apple 스타일 디자인 토큰 (AlarmApp 과 같은 계열)
    - 강조색은 Action Blue 하나 (#0066CC)
    - 그림자 없이 헤어라인과 여백으로 구분, 둥근 모서리
    - 사이드바는 옅은 회색(Parchment), 본문은 흰색
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:IndexExplorer.Views">

    <!-- ===== 색 ===== -->
    <Color x:Key="AccentColor">#0066CC</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#0066CC" />
    <SolidColorBrush x:Key="InkBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8E8E93" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="FieldBrush" Color="#EFEFF2" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#E3E3E8" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F0F6FE" />
    <SolidColorBrush x:Key="PressBrush" Color="#17000000" />
    <!-- 선택·마우스 올림은 파란 계열 (회색은 칙칙하다는 피드백) -->
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F0F6FE" />
    <!-- 모든 마우스 올림은 같은 파란색 하나, 누름·켜짐은 한 단계 진하게 -->
    <SolidColorBrush x:Key="PressBlueBrush" Color="#E2EEFC" />
    <!-- 우클릭·드롭다운 메뉴 항목의 마우스 올림도 같은 파란색 (Fluent 테마 색 이름 덮어쓰기) -->
    <SolidColorBrush x:Key="MenuBarItemBackgroundPointerOver" Color="#F0F6FE" />
    <SolidColorBrush x:Key="MenuBarItemBackgroundMousePointer" Color="#F0F6FE" />
    <SolidColorBrush x:Key="MenuBarItemBackgroundSelected" Color="#E2EEFC" />
    <SolidColorBrush x:Key="SelectBrush" Color="#DDEBFC" />
    <SolidColorBrush x:Key="SelectBorderBrush" Color="#8FBDF0" />
    <SolidColorBrush x:Key="SelectInactiveBrush" Color="#E9F2FD" />
    <SolidColorBrush x:Key="SelectInactiveBorderBrush" Color="#C4DCF6" />
    <SolidColorBrush x:Key="SidebarSelectBrush" Color="#E3EEFC" />
    <SolidColorBrush x:Key="DropBrush" Color="#CFE3FA" />
    <SolidColorBrush x:Key="GuideBrush" Color="#DCDCE1" />
    <SolidColorBrush x:Key="GuideActiveBrush" Color="#86B5EA" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B25000" />
    <SolidColorBrush x:Key="WarningBgBrush" Color="#FFF4E0" />
    <SolidColorBrush x:Key="PinBadgeBgBrush" Color="#EEEDFE" />
    <SolidColorBrush x:Key="PinBadgeBrush" Color="#3C3489" />
    <SolidColorBrush x:Key="DestructiveBrush" Color="#D70015" />

    <!-- Fluent 기본 컨트롤 강조색도 Action Blue로 -->
    <Color x:Key="SystemAccentColor">#0066CC</Color>
    <Color x:Key="SystemAccentColorLight1">#0071E3</Color>
    <Color x:Key="SystemAccentColorLight2">#2997FF</Color>
    <Color x:Key="SystemAccentColorLight3">#99C9FF</Color>
    <Color x:Key="SystemAccentColorDark1">#005BB5</Color>
    <Color x:Key="SystemAccentColorDark2">#004F9E</Color>
    <Color x:Key="SystemAccentColorDark3">#004287</Color>

    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <v:BoolToVisConverter x:Key="BoolToVis" />
    <v:BoolToVisConverter x:Key="NotBoolToVis" Invert="True" />
    <v:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />

    <!-- ===== 사이드바 전용 아이콘 (둥근 색 사각형 + 흰 기호) ===== -->
    <DrawingImage x:Key="IconIndexRoot">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#7F77DD" Geometry="M3,0 H13 A3,3 0 0 1 16,3 V13 A3,3 0 0 1 13,16 H3 A3,3 0 0 1 0,13 V3 A3,3 0 0 1 3,0 Z" />
                <GeometryDrawing Geometry="M8,5.2 V8 M4.5,10.5 V8 H11.5 V10.5">
                    <GeometryDrawing.Pen><Pen Brush="White" Thickness="1.2" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="White" Geometry="M6.6,2.6 H9.4 V5.4 H6.6 Z M3.1,10.4 H5.9 V13.2 H3.1 Z M10.1,10.4 H12.9 V13.2 H10.1 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconInbox">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#378ADD" Geometry="M3,0 H13 A3,3 0 0 1 16,3 V13 A3,3 0 0 1 13,16 H3 A3,3 0 0 1 0,13 V3 A3,3 0 0 1 3,0 Z" />
                <GeometryDrawing Geometry="M3.5,8.5 L5,4 H11 L12.5,8.5 V12 H3.5 Z M3.5,8.5 H6.2 L6.8,9.8 H9.2 L9.8,8.5 H12.5">
                    <GeometryDrawing.Pen><Pen Brush="White" Thickness="1.1" LineJoin="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconRecent">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#EF9F27" Geometry="M3,0 H13 A3,3 0 0 1 16,3 V13 A3,3 0 0 1 13,16 H3 A3,3 0 0 1 0,13 V3 A3,3 0 0 1 3,0 Z" />
                <GeometryDrawing Geometry="M8,3.4 A4.6,4.6 0 1 1 7.99,3.4 Z M8,5.4 V8.2 L10,9.4">
                    <GeometryDrawing.Pen><Pen Brush="White" Thickness="1.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconDisk">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#5B8DEF" Geometry="M3,0 H13 A3,3 0 0 1 16,3 V13 A3,3 0 0 1 13,16 H3 A3,3 0 0 1 0,13 V3 A3,3 0 0 1 3,0 Z" />
                <GeometryDrawing Geometry="M3.6,5.2 H6.6 L7.6,6.3 H12.4 V11.6 H3.6 Z">
                    <GeometryDrawing.Pen><Pen Brush="White" Thickness="1.1" LineJoin="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconAllFiles">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#8E8E93" Geometry="M3,0 H13 A3,3 0 0 1 16,3 V13 A3,3 0 0 1 13,16 H3 A3,3 0 0 1 0,13 V3 A3,3 0 0 1 3,0 Z" />
                <GeometryDrawing Geometry="M5,3.5 H9 L11.5,6 V12.5 H5 Z M9,3.5 V6 H11.5 M6.5,8.5 H10 M6.5,10.5 H10">
                    <GeometryDrawing.Pen><Pen Brush="White" Thickness="1.1" LineJoin="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ===== 툴바 버튼: 투명, 마우스를 올리면 옅은 회색 ===== -->
    <Style x:Key="ToolButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="500" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressBlueBrush}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressBlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ToolButtonB" TargetType="Button" BasedOn="{StaticResource ToolButton}" />
    <!-- 편집 아이콘 버튼: 조금 넓게, 서로 간격 -->
    <Style x:Key="IconTool" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Margin" Value="2,0" />
    </Style>
    <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolButton}" />
    <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolButton}">
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Margin" Value="2,0" />
    </Style>

    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 글자 링크 (파란 글자) -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0,1">
                        <ContentPresenter x:Name="Cp" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cp" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 보조 버튼 (흰 바탕 + 헤어라인 + 둥근 모서리) -->
    <Style x:Key="PearlButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressBlueBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PearlButton}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 세그먼트 (색인 | 원본): 배경은 뒤의 흰 알약이 그리고, 글자만 상태에 따라 -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="Transparent">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cp" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Cp" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 트리 펼침 화살표 -->
    <Style x:Key="ExpanderToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path x:Name="Chev" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><RotateTransform x:Name="Rot" Angle="0" /></Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chev" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chev" Property="Stroke" Value="{StaticResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        트리 항목 + 계층 가이드 선
        - 펼친 하위 항목 왼쪽에 1px 옅은 세로선 (꺾인 가로선 없음)
        - 지금 보고 있는 폴더로 이어지는 경로의 선만 파랗게
    -->
    <Style x:Key="NavItem" TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Bd" CornerRadius="6" Height="28" Background="Transparent" Padding="0,0,8,0" Margin="0,0,0,1" BorderThickness="1" BorderBrush="Transparent">
                            <DockPanel>
                                <ToggleButton x:Name="Expander" Style="{StaticResource ExpanderToggle}" DockPanel.Dock="Left"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Border x:Name="Guide" Margin="10,0,0,0" BorderThickness="1,0,0,0" BorderBrush="Transparent" Padding="8,0,0,0">
                            <ItemsPresenter />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Guide" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarSelectBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelectInactiveBorderBrush}" />
                        </Trigger>
                        <!-- 평소엔 선 없음, 마우스를 올린 항목과 같은 단계(형제들)의 선만 옅게 -->
                        <DataTrigger Binding="{Binding IsOnPath}" Value="True">
                            <Setter TargetName="Guide" Property="BorderBrush" Value="{StaticResource GuideBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DropBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 검색칸 -->
    <Style x:Key="FieldBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 이름 바꾸기 입력칸 (목록·트리 안) -->
    <Style x:Key="RenameBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="3,1" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        목록 열 머리글
        - 위·아래 여백 없이 30px 한 줄, 아주 옅은 세로 구분선
        - 마우스를 올리면 옅은 파란색 + 오른쪽에 필터 ▾ 버튼 (탐색기와 같음)
        - 필터가 걸린 열은 ▾ 가 파란색으로 늘 보인다
    -->
    <Style x:Key="ColumnHeaderStyle" TargetType="GridViewColumnHeader">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid Background="Transparent" MinHeight="30">
                        <Border x:Name="Bd" Background="Transparent" Padding="10,0,4,0"
                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button x:Name="FilterBtn" DockPanel.Dock="Right" Tag="filter" Width="20" Height="22" Margin="4,0,2,0"
                                        Focusable="False" Cursor="Hand" ToolTip="필터" Visibility="Hidden">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" Background="Transparent" CornerRadius="5">
                                                <Path x:Name="P" Data="M0,0 L3.5,3.5 L7,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{StaticResource PressBlueBrush}" />
                                                    <Setter TargetName="P" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Rectangle x:Name="Sep" Width="1" Fill="#ECECF0" HorizontalAlignment="Right" Margin="0,9" SnapsToDevicePixels="True" />
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="9" Margin="0,0,-4,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}" />
                            <Setter TargetName="FilterBtn" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressBlueBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Content.Filtered, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="FilterBtn" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                        <Trigger Property="Role" Value="Padding">
                            <Setter TargetName="Bd" Property="Padding" Value="0" />
                            <Setter TargetName="FilterBtn" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Sep" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 메뉴 글자 크기 -->
    <Style TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
</ResourceDictionary>
