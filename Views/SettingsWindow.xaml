<Window x:Class="IndexExplorer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Icon="/Assets/app.ico" Width="580" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource AppFont}" FontSize="13"
        Foreground="{StaticResource InkBrush}" Background="{StaticResource SidebarBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="28,24,28,22">
        <TextBlock x:Name="Heading" Text="설정" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="Intro" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" LineHeight="20"
                   Text="파일은 옮기지 않습니다. 디스크 어디에 있든 내가 정한 분류(색인)로 묶어서 찾습니다." />

        <!-- 색인할 폴더 -->
        <Border Margin="0,20,0,0" Background="White" CornerRadius="12" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="18,16">
            <StackPanel>
                <TextBlock Text="색인할 폴더" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource SecondaryBrush}"
                           Text="이 폴더들 안의 파일이 자동으로 목록에 오르고, 아직 분류하지 않은 파일은 미분류 함에 모입니다. 업무 파일이 있는 폴더만 고르세요." />
                <ItemsControl x:Name="RootList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButtonB}" Height="26" MinWidth="26" Padding="5,0"
                                            ToolTip="목록에서 빼기 (파일은 지워지지 않음)" Click="RemoveRoot_Click" Tag="{Binding}">
                                        <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{StaticResource SecondaryBrush}" />
                                    </Button>
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" Foreground="#E3A21A" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource PearlButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="AddRoot_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="폴더 추가" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 원본 보관함 -->
        <Border Margin="0,14,0,0" Background="White" CornerRadius="12" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="18,16">
            <StackPanel>
                <TextBlock Text="원본 보관함" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource SecondaryBrush}"
                           Text="저장 위치를 지정하지 않은 색인 폴더에서 새로 만들거나 붙여넣은 파일이, 이곳에 색인과 같은 폴더 구조로 저장됩니다." />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PearlButton}" Content="변경…" Margin="10,0,0,0" Click="ChangeStorage_Click" />
                    <Border Background="{StaticResource FieldBrush}" CornerRadius="8" Padding="10,7">
                        <TextBlock x:Name="StorageText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Border>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- PC 전체 색인 엔진 -->
        <Border Margin="0,14,0,0" Background="White" CornerRadius="12" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="18,16">
            <StackPanel>
                <DockPanel>
                    <Border x:Name="EngineBadge" DockPanel.Dock="Right" CornerRadius="6" Padding="8,2" Background="{StaticResource SidebarBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="EngineStatus" FontSize="12" Foreground="{StaticResource SecondaryBrush}" Text="확인 중…" />
                    </Border>
                    <TextBlock Text="PC 전체 색인 엔진" FontSize="15" FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource SecondaryBrush}" LineHeight="19"
                           Text="디스크 장부를 직접 읽어 모든 드라이브의 파일을 몇 초 만에 모으고, 바뀌는 즉시 따라갑니다. 파일 종류 보기(엑셀만, 이미지만…)가 PC 전체에서 동작합니다. 읽기만 하며, 설치할 때 관리자 승인이 한 번 필요합니다." />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="EngineInstallBtn" Style="{StaticResource PrimaryButton}" Content="설치" Click="EngineInstall_Click" />
                    <Button x:Name="EngineRemoveBtn" Style="{StaticResource PearlButton}" Content="제거" Margin="8,0,0,0" Click="EngineRemove_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DockPanel Margin="0,22,0,0" LastChildFill="False">
            <Button x:Name="SaveBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="저장" Padding="20,8" IsDefault="True" Click="Save_Click" />
            <Button x:Name="CancelBtn" DockPanel.Dock="Right" Style="{StaticResource PearlButton}" Content="취소" Padding="18,8" Margin="0,0,10,0" IsCancel="True" />
        </DockPanel>
    </StackPanel>
</Window>
