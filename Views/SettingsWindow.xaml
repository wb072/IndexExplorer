<Window x:Class="IndexExplorer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Icon="/Assets/app.ico" Width="820" Height="600" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource AppFont}" FontSize="13"
        Foreground="{StaticResource InkBrush}" Background="{StaticResource CanvasBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- 왼쪽 목록: 탐색기 사이드바 항목과 똑같이 (28px, 옅은 파란 호버, 선택은 파란 바탕 + 가는 테두리) -->
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Pref" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Height="28" Background="Transparent" Padding="10,0,8,0" Margin="0,0,0,1"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarSelectBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelectInactiveBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavIcon" TargetType="Image">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>

        <!-- 쪽 제목 · 구역 제목 · 설명 (상자 없이 흰 바탕에 가는 선으로만 구분) -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Margin" Value="0,2,0,10" />
        </Style>
        <!-- 줄 안의 작은 아이콘 버튼 (마우스를 올린 줄에서만 보임) -->
        <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource ToolButtonB}">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="5,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 아래 버튼 -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="24,12,24,14">
            <DockPanel LastChildFill="False">
                <Button x:Name="SaveBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="저장" Padding="20,8" IsDefault="True" Click="Save_Click" />
                <Button x:Name="CancelBtn" DockPanel.Dock="Right" Style="{StaticResource PearlButton}" Content="취소" Padding="18,8" Margin="0,0,10,0" IsCancel="True" />
            </DockPanel>
        </Border>

        <!-- 왼쪽 목록 (탐색기 사이드바와 같은 모양) -->
        <Border DockPanel.Dock="Left" Width="200" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0" Padding="10,14,10,10">
            <StackPanel>
                <RadioButton x:Name="TabGeneral" Style="{StaticResource NavTab}" IsChecked="True" Checked="Tab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{DynamicResource FolderIcon}" Style="{StaticResource NavIcon}" />
                        <TextBlock Text="일반" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabKinds" Style="{StaticResource NavTab}" Checked="Tab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconAllFiles}" Style="{StaticResource NavIcon}" />
                        <TextBlock Text="파일 종류" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabEngine" Style="{StaticResource NavTab}" Checked="Tab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="14" Width="16" Foreground="#8B5CF6" Margin="0,0,9,0" />
                        <TextBlock Text="색인 엔진" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabAbout" Style="{StaticResource NavTab}" Checked="Tab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconAppSmall}" Style="{StaticResource NavIcon}" />
                        <TextBlock Text="정보" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <Grid>
            <!-- ===== 일반 ===== -->
            <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,18,28,20">
                    <TextBlock x:Name="PageTitleGeneral" Text="일반" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="Heading" Text="어떤 폴더의 파일을 정리할까요?" FontSize="15" Margin="0,-6,0,14" Visibility="Collapsed" />

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButtonB}" Click="AddRoot_Click" VerticalAlignment="Top" Height="28">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="폴더 추가" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="색인할 폴더" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="이 폴더들 안의 파일이 자동으로 목록에 오르고, 아직 분류하지 않은 파일은 미분류 함에 모입니다." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Card}">
                        <ItemsControl x:Name="RootList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="6" Padding="8,6,4,6" Background="Transparent">
                                        <DockPanel>
                                            <Button x:Name="Del" DockPanel.Dock="Right" Style="{StaticResource RowIconButton}" Visibility="Hidden"
                                                    ToolTip="목록에서 빼기 (파일은 지워지지 않음)" Click="RemoveRoot_Click" Tag="{Binding}">
                                                <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{StaticResource SecondaryBrush}" />
                                            </Button>
                                            <Image Source="{DynamicResource FolderIcon}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Converter={StaticResource PathLeaf}}" VerticalAlignment="Center" Width="130" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}" />
                                            <Setter TargetName="Del" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <DockPanel Margin="0,22,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButtonB}" Content="변경…" Click="ChangeStorage_Click" VerticalAlignment="Top" Height="28" Padding="10,0" />
                        <StackPanel>
                            <TextBlock Text="원본 보관함" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="저장 위치를 지정하지 않은 색인 폴더에서 새로 만들거나 붙여넣은 파일이, 이곳에 색인과 같은 폴더 구조로 저장됩니다." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Card}">
                        <DockPanel Margin="8,6,4,6">
                            <Image Source="{DynamicResource FolderIcon}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="StorageName" DockPanel.Dock="Left" Width="130" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="StorageText" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 파일 종류 ===== -->
            <ScrollViewer x:Name="PageKinds" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="28,18,28,20">
                    <TextBlock Text="파일 종류" Style="{StaticResource PageTitle}" />
                    <DockPanel>
                        <Button x:Name="AddKindBtn" DockPanel.Dock="Right" Style="{StaticResource ToolButtonB}" Click="AddKind_Click" VerticalAlignment="Top" Height="28">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="새 종류" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="왼쪽에 보일 종류" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="체크한 종류가 왼쪽 &quot;파일 종류&quot;에 나옵니다. 연필을 누르거나 두 번 누르면 이름과 확장자를 고칩니다." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Card}">
                        <ItemsControl x:Name="KindList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="6" Padding="2,0,2,0" Margin="0,0,6,1" Height="30" Background="Transparent" ToolTip="{Binding ExtTip}"
                                            Tag="{Binding}" MouseLeftButtonDown="KindRow_MouseDown">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" Style="{StaticResource BlueCheck}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <Button x:Name="Edit" DockPanel.Dock="Right" Style="{StaticResource RowIconButton}" Visibility="Hidden"
                                                    ToolTip="이름·확장자 편집" Click="EditKind_Click" Tag="{Binding}">
                                                <TextBlock Text="&#xE70F;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                            </Button>
                                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ExtShort}" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="11.5"
                                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}" />
                                            <Setter TargetName="Edit" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="파일 종류에서 뺀 폴더" Style="{StaticResource SectionTitle}" Margin="0,22,0,4" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="파일 종류 보기에서 우클릭 › &quot;이 폴더를 파일 종류에서 빼기&quot;로 뺀 폴더입니다. ×를 누르면 다시 보입니다." />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="KindExEmpty" Text="없음" Foreground="{StaticResource MutedBrush}" Margin="8,6" />
                            <ItemsControl x:Name="KindExList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="6" Padding="8,6,4,6" Background="Transparent">
                                            <DockPanel>
                                                <Button x:Name="Del" DockPanel.Dock="Right" Style="{StaticResource RowIconButton}" Visibility="Hidden"
                                                        ToolTip="다시 보이게" Click="RemoveKindEx_Click" Tag="{Binding}">
                                                    <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{StaticResource SecondaryBrush}" />
                                                </Button>
                                                <Image Source="{DynamicResource FolderIcon}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.55" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}" />
                                                <Setter TargetName="Del" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 색인 엔진 ===== -->
            <ScrollViewer x:Name="PageEngine" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="28,18,28,20">
                    <DockPanel Margin="0,0,0,14">
                        <Border x:Name="EngineBadge" DockPanel.Dock="Right" CornerRadius="6" Padding="8,2" Background="{StaticResource SidebarBrush}" VerticalAlignment="Center">
                            <TextBlock x:Name="EngineStatus" FontSize="12" Foreground="{StaticResource SecondaryBrush}" Text="확인 중…" />
                        </Border>
                        <TextBlock Text="색인 엔진" Style="{StaticResource PageTitle}" Margin="0" />
                    </DockPanel>

                    <TextBlock Text="PC 전체 색인" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="디스크 장부를 직접 읽어 모든 드라이브의 파일을 몇 초 만에 모으고, 바뀌는 즉시 따라갑니다. 파일 종류 보기가 PC 전체에서 동작합니다. 읽기만 하며, 설치·업데이트·제거할 때 관리자 승인 창이 한 번 뜹니다." />
                    <Border Style="{StaticResource Card}" Padding="0,12,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="EngineInstallBtn" Style="{StaticResource PrimaryButton}" Content="설치" Click="EngineInstall_Click" />
                            <Button x:Name="EngineRemoveBtn" Style="{StaticResource PearlButton}" Content="제거" Margin="8,0,0,0" Click="EngineRemove_Click" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="DrivesSection" Visibility="Collapsed" Margin="0,22,0,0">
                        <TextBlock Text="드라이브" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="EngineFiles" Style="{StaticResource Hint}" />
                        <Border Style="{StaticResource Card}">
                            <ItemsControl x:Name="DriveList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="6" Padding="8,7,8,7" Background="Transparent">
                                            <DockPanel>
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Fill="#34C759" Visibility="{Binding LiveVis}" VerticalAlignment="Center" Margin="10,0,2,0" ToolTip="실시간 반영 중" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="170" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding State}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 정보 ===== -->
            <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="28,18,28,20">
                    <TextBlock Text="정보" Style="{StaticResource PageTitle}" />
                    <DockPanel Margin="0,0,0,22">
                        <Image Source="{StaticResource IconApp}" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Top" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="색인 탐색기" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource SecondaryBrush}" Margin="0,2,0,0" />
                            <TextBlock Text="파일은 옮기지 않고, 디스크 어디에 있든 내가 정한 분류(색인)로 묶어서 찾습니다." TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButtonB}" Content="폴더 열기" Click="OpenData_Click" VerticalAlignment="Top" Height="28" Padding="10,0" />
                        <StackPanel>
                            <TextBlock Text="데이터" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Text="색인 폴더와 연결 정보만 담고 있습니다. 원본 파일은 이 폴더에 복사되지 않습니다." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Card}">
                        <DockPanel Margin="8,6,4,6">
                            <Image Source="{DynamicResource FolderIcon}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock DockPanel.Dock="Left" Text="색인 정보와 설정" Width="130" VerticalAlignment="Center" />
                            <TextBlock x:Name="DataText" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
