<Window x:Class="IndexExplorer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Icon="/Assets/app.ico" Width="680" Height="640" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource AppFont}" FontSize="13"
        Foreground="{StaticResource InkBrush}" Background="{StaticResource SidebarBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- 위쪽 탭: 색 타일 아이콘 + 이름 (macOS 환경설정처럼). 고른 탭은 옅은 파란 바탕 -->
        <Style x:Key="PrefTab" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Pref" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Width="92" Height="62" CornerRadius="9" Background="Transparent">
                            <StackPanel VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="7" Background="{TemplateBinding Background}" HorizontalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Glyph}" FontSize="15" Foreground="White" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"
                                           Foreground="{StaticResource SecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressBlueBrush}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 카드 위 작은 제목 (그룹 목록) -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="Margin" Value="4,0,0,7" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Margin" Value="4,7,0,0" />
        </Style>
        <!-- 줄 안의 작은 아이콘 버튼 (마우스를 올린 줄에서만 보임) -->
        <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource ToolButtonB}">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="5,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 탭 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,10,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton x:Name="TabGeneral" Style="{StaticResource PrefTab}" Content="일반" Tag="&#xE713;" Background="#8E8E93" IsChecked="True" Checked="Tab_Checked" />
                <RadioButton x:Name="TabKinds" Style="{StaticResource PrefTab}" Content="파일 종류" Tag="&#xF0E2;" Background="#2F80ED" Checked="Tab_Checked" />
                <RadioButton x:Name="TabEngine" Style="{StaticResource PrefTab}" Content="색인 엔진" Tag="&#xE945;" Background="#8B5CF6" Checked="Tab_Checked" />
                <RadioButton x:Name="TabAbout" Style="{StaticResource PrefTab}" Content="정보" Tag="&#xE946;" Background="#34AADC" Checked="Tab_Checked" />
            </StackPanel>
        </Border>

        <!-- 아래 버튼 -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="24,12,24,14">
            <DockPanel LastChildFill="False">
                <Button x:Name="SaveBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="저장" Padding="20,8" IsDefault="True" Click="Save_Click" />
                <Button x:Name="CancelBtn" DockPanel.Dock="Right" Style="{StaticResource PearlButton}" Content="취소" Padding="18,8" Margin="0,0,10,0" IsCancel="True" />
            </DockPanel>
        </Border>

        <Grid>
            <!-- ===== 일반 ===== -->
            <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,20">
                    <TextBlock x:Name="Heading" Text="어떤 폴더의 파일을 정리할까요?" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,14" Visibility="Collapsed" />

                    <TextBlock Text="색인할 폴더" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="16,4,10,10">
                        <StackPanel>
                            <ItemsControl x:Name="RootList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                            <DockPanel>
                                                <Button x:Name="Del" DockPanel.Dock="Right" Style="{StaticResource RowIconButton}" Visibility="Hidden"
                                                        ToolTip="목록에서 빼기 (파일은 지워지지 않음)" Click="RemoveRoot_Click" Tag="{Binding}">
                                                    <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{StaticResource SecondaryBrush}" />
                                                </Button>
                                                <Image Source="{DynamicResource FolderIcon}" Width="20" Height="20" Margin="0,0,11,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Converter={StaticResource PathLeaf}}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Del" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource PearlButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="AddRoot_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="폴더 추가" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="이 폴더들 안의 파일이 자동으로 목록에 오르고, 아직 분류하지 않은 파일은 미분류 함에 모입니다. 업무 파일이 있는 폴더만 고르세요." />

                    <TextBlock Text="원본 보관함" Style="{StaticResource SectionTitle}" Margin="4,22,0,7" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PearlButton}" Content="변경…" Margin="10,0,0,0" Click="ChangeStorage_Click" VerticalAlignment="Center" />
                            <Image Source="{DynamicResource FolderIcon}" Width="20" Height="20" Margin="0,0,11,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="StorageName" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="StorageText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="저장 위치를 지정하지 않은 색인 폴더에서 새로 만들거나 붙여넣은 파일이, 이곳에 색인과 같은 폴더 구조로 저장됩니다." />
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 파일 종류 ===== -->
            <ScrollViewer x:Name="PageKinds" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="28,20,28,20">
                    <DockPanel Margin="0,0,0,7">
                        <Button x:Name="AddKindBtn" DockPanel.Dock="Right" Style="{StaticResource PearlButton}" Click="AddKind_Click" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="새 종류" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="왼쪽에 보일 파일 종류" Style="{StaticResource SectionTitle}" Margin="4,0,0,0" VerticalAlignment="Bottom" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="8,6">
                        <ItemsControl x:Name="KindList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="7" Padding="2,0,2,0" Margin="2,1" Height="34" Background="Transparent" ToolTip="{Binding ExtTip}"
                                            Tag="{Binding}" MouseLeftButtonDown="KindRow_MouseDown">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" Style="{StaticResource BlueCheck}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <Button x:Name="Edit" DockPanel.Dock="Right" Style="{StaticResource RowIconButton}" Visibility="Hidden"
                                                    ToolTip="이름·확장자 편집" Click="EditKind_Click" Tag="{Binding}">
                                                <TextBlock Text="&#xE70F;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                            </Button>
                                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ExtShort}" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="11.5"
                                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}" />
                                            <Setter TargetName="Edit" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="체크한 종류가 왼쪽 &quot;파일 종류&quot;에 나옵니다. 연필을 누르거나 줄을 두 번 누르면 이름과 확장자를 고칩니다. 같은 확장자가 두 종류에 있으면 목록에서 뒤의 종류에 나옵니다." />

                    <TextBlock Text="파일 종류에서 뺀 폴더" Style="{StaticResource SectionTitle}" Margin="4,22,0,7" />
                    <Border Style="{StaticResource Card}" Padding="16,4,10,4">
                        <StackPanel>
                            <TextBlock x:Name="KindExEmpty" Text="없음" Foreground="{StaticResource MutedBrush}" Margin="0,8" />
                            <ItemsControl x:Name="KindExList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                            <DockPanel>
                                                <Button x:Name="Del" DockPanel.Dock="Right" Style="{StaticResource RowIconButton}" Visibility="Hidden"
                                                        ToolTip="다시 보이게" Click="RemoveKindEx_Click" Tag="{Binding}">
                                                    <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{StaticResource SecondaryBrush}" />
                                                </Button>
                                                <Image Source="{DynamicResource FolderIcon}" Width="18" Height="18" Margin="0,0,11,0" VerticalAlignment="Center" Opacity="0.55" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Del" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="파일 종류 보기에서 우클릭 › &quot;이 폴더를 파일 종류에서 빼기&quot;로 뺀 폴더입니다. ×를 누르면 다시 보입니다. 파일은 영향이 없습니다." />
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 색인 엔진 ===== -->
            <ScrollViewer x:Name="PageEngine" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="28,20,28,20">
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="11" Background="#8B5CF6" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="22" Foreground="White" HorizontalAlignment="Center" />
                                </Border>
                                <Border x:Name="EngineBadge" DockPanel.Dock="Right" CornerRadius="6" Padding="8,2" Background="{StaticResource SidebarBrush}" VerticalAlignment="Top">
                                    <TextBlock x:Name="EngineStatus" FontSize="12" Foreground="{StaticResource SecondaryBrush}" Text="확인 중…" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="PC 전체 색인 엔진" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource SecondaryBrush}" LineHeight="19"
                                               Text="디스크 장부를 직접 읽어 모든 드라이브의 파일을 몇 초 만에 모으고, 바뀌는 즉시 따라갑니다. 파일 종류 보기가 PC 전체에서 동작합니다. 읽기만 합니다." />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="58,14,0,0">
                                <Button x:Name="EngineInstallBtn" Style="{StaticResource PrimaryButton}" Content="설치" Click="EngineInstall_Click" />
                                <Button x:Name="EngineRemoveBtn" Style="{StaticResource PearlButton}" Content="제거" Margin="8,0,0,0" Click="EngineRemove_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Text="설치·업데이트·제거할 때 관리자 승인 창이 한 번 뜹니다." />

                    <StackPanel x:Name="DrivesSection" Visibility="Collapsed">
                        <TextBlock Text="드라이브" Style="{StaticResource SectionTitle}" Margin="4,22,0,7" />
                        <Border Style="{StaticResource Card}" Padding="16,4,16,4">
                            <ItemsControl x:Name="DriveList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="{Binding Border}" Padding="0,9">
                                            <DockPanel>
                                                <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Fill="#34C759" Visibility="{Binding LiveVis}" VerticalAlignment="Center" Margin="10,0,2,0" ToolTip="실시간 반영 중" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="{Binding State}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock x:Name="EngineFiles" Style="{StaticResource Hint}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 정보 ===== -->
            <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="28,30,28,20">
                    <Image Source="{StaticResource IconApp}" Width="72" Height="72" HorizontalAlignment="Center" />
                    <TextBlock Text="색인 탐색기" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock x:Name="VersionText" FontSize="12.5" Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="파일은 옮기지 않고, 디스크 어디에 있든 내가 정한 분류(색인)로 묶어서 찾습니다." TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource SecondaryBrush}" Margin="40,14,40,0" LineHeight="20" />

                    <TextBlock Text="데이터" Style="{StaticResource SectionTitle}" Margin="4,28,0,7" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PearlButton}" Content="폴더 열기" Margin="10,0,0,0" Click="OpenData_Click" VerticalAlignment="Center" />
                            <Image Source="{DynamicResource FolderIcon}" Width="20" Height="20" Margin="0,0,11,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="색인 정보와 설정" />
                                <TextBlock x:Name="DataText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Text="색인 폴더와 연결 정보만 담고 있습니다. 원본 파일은 이 폴더에 복사되지 않습니다." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
