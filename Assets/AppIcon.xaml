<!--
    색인 탐색기 앱 아이콘 — "엄지 색인"
    보라 폴더 + 사전 옆면 같은 색인 탭 세 개 + 목차 줄.
    탐색기의 노란 폴더와 같은 실루엣으로 "파일 관리"임을 알리고, 보라색·오른쪽 색인 탭으로 구분한다.
    64×64 좌표. 앱 안(색인 스위치 등)에서 쓰고, Assets\make-icon.ps1 이 이 파일로 app.ico 를 만든다.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DrawingImage x:Key="IconApp">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 크기 기준 (투명) -->
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H64 V64 H0 Z" />
                <!-- 색인 탭 (폴더 뒤에서 오른쪽으로 삐져나옴) -->
                <GeometryDrawing Brush="#BDB5F4" Geometry="M52,23 H58.5 A2.5,2.5 0 0 1 61,25.5 V31.5 A2.5,2.5 0 0 1 58.5,34 H52 Z" />
                <GeometryDrawing Brush="#A196EE" Geometry="M52,34.5 H58.5 A2.5,2.5 0 0 1 61,37 V43 A2.5,2.5 0 0 1 58.5,45.5 H52 Z" />
                <GeometryDrawing Brush="#8579E3" Geometry="M52,46 H58.5 A2.5,2.5 0 0 1 61,48.5 V54.5 A2.5,2.5 0 0 1 58.5,57 H52 Z" />
                <!-- 폴더 뒷면 -->
                <GeometryDrawing Brush="#4C42AE" Geometry="M3,15 A4,4 0 0 1 7,11 H19.5 L24.5,16 H51 A4,4 0 0 1 55,20 V51 A4,4 0 0 1 51,55 H7 A4,4 0 0 1 3,51 Z" />
                <!-- 폴더 앞면 -->
                <GeometryDrawing Geometry="M3,24 A4,4 0 0 1 7,20 H51 A4,4 0 0 1 55,24 V53 A4,4 0 0 1 51,57 H7 A4,4 0 0 1 3,53 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#8E87EA" />
                            <GradientStop Offset="1" Color="#6E64D6" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- 목차 줄 -->
                <GeometryDrawing Brush="#FFFFFF" Geometry="M11.5,29 H32 A1.8,1.8 0 0 1 32,32.6 H11.5 A1.8,1.8 0 0 1 11.5,29 Z" />
                <GeometryDrawing Brush="#E6E3FC" Geometry="M11.5,37 H40 A1.8,1.8 0 0 1 40,40.6 H11.5 A1.8,1.8 0 0 1 11.5,37 Z" />
                <GeometryDrawing Brush="#CFCAF7" Geometry="M11.5,45 H28 A1.8,1.8 0 0 1 28,48.6 H11.5 A1.8,1.8 0 0 1 11.5,45 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
